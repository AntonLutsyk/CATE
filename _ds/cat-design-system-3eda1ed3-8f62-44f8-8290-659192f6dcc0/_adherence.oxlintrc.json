{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/cat/**",
              "components/core/**",
              "components/feedback/**",
              "components/filters/**",
              "components/forms/**",
              "components/gallery/**",
              "components/media/**",
              "components/motif/**",
              "components/navigation/**",
              "components/search/**",
              "components/selection/**",
              "components/shelter/**",
              "components/states/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Serif Display|Manrope))/i]",
        "message": "Font not provided by the design system. Available: DM Serif Display, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|when|state|key|ref|className|style|children)$/]",
        "message": "<JourneyStep> doesn't accept that prop. Declared props: title, detail, when, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|current|upcoming|blocked)$/]",
        "message": "<JourneyStep> state must be one of 'done' | 'current' | 'upcoming' | 'blocked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|dot|children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, dot, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:available|pending|adopted|new|urgent|info|neutral)$/]",
        "message": "<Badge> tone must be one of 'available' | 'pending' | 'adopted' | 'new' | 'urgent' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconEnd|loading|block|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconEnd, loading, block, href, children."
